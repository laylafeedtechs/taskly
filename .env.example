# Copy to .env and adjust. Every variable is optional for local development.

# Public URL of the frontend (used in e-mails, OAuth redirects and CORS).
APP_URL=http://localhost:3000
PORT=5000
# NODE_ENV=production  # enables Secure cookies, HSTS and HTTPS-only webhooks

# Google OAuth 2.0 / OpenID Connect
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for invitations, password resets and e-mail notifications.
# Without SMTP_HOST, e-mails are written to data/outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taskly <no-reply@example.com>"

# Extra allowed CORS origins (comma separated)
CORS_ORIGINS=
# Set to true when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false
# Allow webhooks to private/internal addresses (development only)
ALLOW_PRIVATE_WEBHOOKS=false
# Alternative data directory
# TASKLY_DATA_DIR=./data

# --- Security & privacy -------------------------------------------------------
# 32-byte key (base64) used to encrypt MFA secrets, webhook secrets and backups.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a key file is created in TASKLY_KEY_DIR (default ~/.taskly). Keep it
# OUTSIDE the data and backup directories, and back it up separately.
TASKLY_ENCRYPTION_KEY=
# TASKLY_KEY_DIR=
# Encrypted daily backups (must be outside the data directory; ideally another disk/host).
# TASKLY_BACKUP_DIR=
# Name of the hosting provider, shown in the privacy page's processor list.
HOSTING_PROVIDER=
