{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskly",
  "main": "worker/index.js",
  // httpServerHandler (Express on Workers) needs nodejs_compat and a date
  // >= 2025-09-01, which also enables the node:http server modules.
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend (Vite build) served by Static Assets. Only /api/* runs the
  // Worker first; everything else is a static file or the SPA index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Created with:  npx wrangler d1 create taskly
  // The database_id is not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskly",
      "database_id": "6e305d31-b5ec-41f3-af6a-afe9083d2d46",
      "migrations_dir": "migrations"
    }
  ],

  // File uploads and avatars (optional). Enable R2 in the dashboard, run
  //   npx wrangler r2 bucket create taskly-files
  // and uncomment this block. Without it, uploads answer 503 with a clear message.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "taskly-files" }],

  // Every minute: publication scheduler (backend-driven). Hourly maintenance
  // runs at minute 0; retention, token renewal and account sync at 03:00 UTC.
  "triggers": { "crons": ["* * * * *"] },

  // Non-secret configuration. Secrets go through `wrangler secret put`.
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://taskly.layla-figueiredo.workers.dev",
    "HOSTING_PROVIDER": "Cloudflare (Workers, D1) — rede global, pode envolver transferência internacional"
  },

  "observability": { "enabled": true }
}
